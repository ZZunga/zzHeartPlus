<settings>
    <setting propertyKey="@Properties.appVersion" title="@Strings.appVersion_title">
        <settingConfig type="alphaNumeric" readonly="true"/>
    </setting>

    <setting propertyKey="@Properties.dataMode" title="@Strings.dataMode_title">
        <settingConfig type="list">
            <listEntry value="0">@Strings.heartrateAvg_title</listEntry>
            <listEntry value="1">@Strings.heartrateMax_title</listEntry>
            <listEntry value="2">@Strings.heartrateLap_title</listEntry>
            <listEntry value="3">@Strings.none_title</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.HeartZoneBar" title="@Strings.HeartZoneBar_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.HeartZoneHistory" title="@Strings.HeartZoneHistory_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.histStyle" title="@Strings.histStyle_title">
        <settingConfig type="list">
            <listEntry value="0">@Strings.histStripe</listEntry>
            <listEntry value="1">@Strings.histSolid</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.showPct" title="@Strings.showPct_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.tidAnalysis" title="@Strings.tidAnalysis_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.showIcon" title="@Strings.showIcon_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.zoneDecimal" title="@Strings.zoneDecimal_title">
        <settingConfig type="boolean"/>
    </setting>

    <setting propertyKey="@Properties.calcHeartZone" title="@Strings.calcHeartZone_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.calcTypeHZ" title="@Strings.calcTypeHZ_title">
        <settingConfig type="list">
            <listEntry value="0">@Strings.DefaultHZ</listEntry>
            <listEntry value="1">@Strings.JeoFrielHZ</listEntry>
            <listEntry value="2">@Strings.AndrewCogganHZ</listEntry>
            <listEntry value="3">@Strings.UsaCyclingHZ</listEntry>
            <listEntry value="4">@Strings.BritishCyclingHZ</listEntry>
            <listEntry value="5">@Strings.StravaHZ</listEntry>
            <listEntry value="6">@Strings.GarminHZ</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.maxHeartRate" title="@Strings.maxHeartRate_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>

    <setting propertyKey="@Properties.manualHeartZone" title="@Strings.manualHeartZone_title">
        <settingConfig type="boolean"/>
    </setting>
    <setting propertyKey="@Properties.Zone1minValue" title="@Strings.Zone1minValue_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>
    <setting propertyKey="@Properties.Zone1maxValue" title="@Strings.Zone1maxValue_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>
    <setting propertyKey="@Properties.Zone2maxValue" title="@Strings.Zone2maxValue_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>
    <setting propertyKey="@Properties.Zone3maxValue" title="@Strings.Zone3maxValue_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>
    <setting propertyKey="@Properties.Zone4maxValue" title="@Strings.Zone4maxValue_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>
    <setting propertyKey="@Properties.Zone5maxValue" title="@Strings.Zone5maxValue_title">
        <settingConfig type="numeric" min="50" max="250"/>
    </setting>

    <setting propertyKey="@Properties.threshold" title="@Strings.threshold">
        <settingConfig type="numeric" min="0" max="100"/>
    </setting>
    <setting propertyKey="@Properties.colorHigh" title="@Strings.colorHigh">
        <settingConfig type="list">
			<listEntry value="1">@Strings.colorRed</listEntry>
			<listEntry value="2">@Strings.colorOrange</listEntry>
			<listEntry value="3">@Strings.colorYellow</listEntry>
			<listEntry value="4">@Strings.colorYellowOrange</listEntry>
			<listEntry value="5">@Strings.colorGreen</listEntry>
			<listEntry value="6">@Strings.colorBlue</listEntry>
			<listEntry value="7">@Strings.colorPurple</listEntry>
			<listEntry value="8">@Strings.colorPink</listEntry>
			<listEntry value="9">@Strings.colorPinkRed</listEntry>
			<listEntry value="10">@Strings.colorGray</listEntry>
			<listEntry value="11">@Strings.colorZone</listEntry>
			<listEntry value="0">@Strings.colorDefault</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.colorLow" title="@Strings.colorLow">
        <settingConfig type="list">
			<listEntry value="1">@Strings.colorRed</listEntry>
			<listEntry value="2">@Strings.colorOrange</listEntry>
			<listEntry value="3">@Strings.colorYellow</listEntry>
			<listEntry value="4">@Strings.colorYellowOrange</listEntry>
			<listEntry value="5">@Strings.colorGreen</listEntry>
			<listEntry value="6">@Strings.colorBlue</listEntry>
			<listEntry value="7">@Strings.colorPurple</listEntry>
			<listEntry value="8">@Strings.colorPink</listEntry>
			<listEntry value="9">@Strings.colorPinkRed</listEntry>
			<listEntry value="10">@Strings.colorGray</listEntry>
			<listEntry value="11">@Strings.colorZone</listEntry>
			<listEntry value="0">@Strings.colorDefault</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.bgMode" title="@Strings.bgMode_title">
        <settingConfig type="list">
            <listEntry value="0">@Strings.bgAuto</listEntry>
            <listEntry value="1">@Strings.bgPlain</listEntry>
            <listEntry value="2">@Strings.bgClear</listEntry>
        </settingConfig>
    </setting>
</settings>
