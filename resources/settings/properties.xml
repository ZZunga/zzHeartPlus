<properties>
    <property id="appVersion" type="string">1.0.2</property>

    <!-- 우측 상단 보조값: 0=평균 1=최대 2=랩평균 3=없음 (zzHeartChart 와 같은 번호) -->
    <property id="dataMode" type="number">0</property>

    <!-- 하단 존 띠 + 현재 위치 화살표 / 존별 시간 % 히스토그램 -->
    <property id="HeartZoneBar" type="boolean">true</property>
    <property id="HeartZoneHistory" type="boolean">true</property>
    <!-- 막대 모양: 0=줄무늬 1=채움 / 막대 위 % 숫자 -->
    <property id="histStyle" type="number">0</property>
    <property id="showPct" type="boolean">true</property>
    <!-- 운동 형태 분석: 넓고 높은 칸에서 위쪽 절반 값 + 운동 형태, 아래쪽 절반 히스토그램 -->
    <property id="tidAnalysis" type="boolean">true</property>

    <!-- 좌측 상단 하트 + 현재 존 / 존 소수 표시 (2.4) -->
    <property id="showIcon" type="boolean">true</property>
    <property id="zoneDecimal" type="boolean">true</property>

    <!-- 심박존 출처: 직접 입력 > 최대심박 계산 > 기기 사용자 프로필(기본) -->
    <property id="calcHeartZone" type="boolean">false</property>
    <!-- 0 기본 1 Joe Friel 2 Andrew Coggan 3 USA Cycling 4 British Cycling 5 Strava 6 Garmin -->
    <property id="calcTypeHZ" type="number">0</property>
    <property id="maxHeartRate" type="number">180</property>

    <property id="manualHeartZone" type="boolean">false</property>
    <property id="Zone1minValue" type="number">130</property>
    <property id="Zone1maxValue" type="number">160</property>
    <property id="Zone2maxValue" type="number">178</property>
    <property id="Zone3maxValue" type="number">190</property>
    <property id="Zone4maxValue" type="number">200</property>
    <property id="Zone5maxValue" type="number">214</property>

    <!-- 색 테마: 보조값 대비 threshold% 넘게 높으면 colorHigh, 낮으면 colorLow -->
    <property id="threshold" type="number">5</property>
    <property id="colorHigh" type="number">0</property>
    <property id="colorLow" type="number">0</property>

    <!-- 배경색: 0=기기 화면색에 맞춤 1=검정/흰색 그대로(기본) 2=투명(안 칠함) -->
    <property id="bgMode" type="number">1</property>
</properties>
